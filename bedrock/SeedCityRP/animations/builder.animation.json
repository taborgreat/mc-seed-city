{
  "format_version": "1.8.0",
  "animations": {
    "animation.seedcity.builder": {
      "loop": true,
      "bones": {
        "right_leg": {
          "rotation": [
            "math.sin(q.anim_time * 380) * 30 * v.walk",
            0,
            0
          ]
        },
        "left_leg": {
          "rotation": [
            "math.sin(q.anim_time * 380) * -30 * v.walk",
            0,
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "(q.property('seedcity:pose') == 4) ? 7+v.stroke*69+v.arc*23 : math.sin(q.anim_time*380)*-18*v.walk",
            "(q.property('seedcity:pose') == 4) ? v.sweep*18 : 0",
            "(q.property('seedcity:pose') == 4) ? v.arc*23-2 : -2"
          ]
        },
        "left_arm": {
          "rotation": [
            "math.sin(q.anim_time * 380) * 18 * v.walk",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "q.property('seedcity:pose') == 6 ? 48 + math.sin(q.anim_time*45)*8 : -math.clamp(q.target_x_rotation,-60,30)",
            "-math.clamp(q.target_y_rotation,-35,35)",
            0
          ]
        },
        "cargo": {
          "scale": "q.property('seedcity:pose') == 5 ? 1 : 0"
        },
        "body": {
          "position": [
            0,
            "q.property('seedcity:pose') == 0 || q.property('seedcity:pose') == 3 ? math.sin(q.anim_time*115)*0.22 : 0",
            0
          ],
          "rotation": [
            0,
            "(q.property('seedcity:pose') == 4) ? v.sweep*9 : 0",
            0
          ]
        }
      }
    }
  }
}
