{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "seedcity:builder",
      "materials": {
        "default": "entity_alphatest",
        "glow": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/builder",
        "glow": "textures/entity/builder_glow"
      },
      "geometry": {
        "default": "geometry.seedcity.builder"
      },
      "animations": {
        "main": "animation.seedcity.builder"
      },
      "scripts": {
        "pre_animation": [
          "v.walk = (q.property('seedcity:pose') == 2) ? 1.0 : (q.property('seedcity:pose') == 0 ? math.min(q.modified_move_speed * 3.0, 1.0) : 0.0);",
          "v.p = math.mod(q.anim_time,0.3)/0.3;",
          "v.stroke = math.sin((1-math.pow(1-v.p,4))*180);",
          "v.arc = math.sin(v.p*180);",
          "v.sweep = math.sin(math.sqrt(v.p)*360);"
        ],
        "animate": [
          "main"
        ]
      },
      "render_controllers": [
        "controller.render.seedcity",
        "controller.render.seedcity_glow"
      ],
      "spawn_egg": {
        "base_color": "#59776D",
        "overlay_color": "#53E7ED"
      },
      "enable_attachables": false
    }
  }
}
