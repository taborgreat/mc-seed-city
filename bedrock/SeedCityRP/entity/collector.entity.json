{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "seedcity:collector",
      "materials": {
        "default": "entity_alphatest",
        "glow": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/collector",
        "glow": "textures/entity/collector_glow"
      },
      "geometry": {
        "default": "geometry.seedcity.collector"
      },
      "animations": {
        "main": "animation.seedcity.collector"
      },
      "scripts": {
        "pre_animation": [
          "v.walk = (q.property('seedcity:pose') == 2) ? 1.0 : (q.property('seedcity:pose') == 0 ? math.min(q.modified_move_speed * 3.0, 1.0) : 0.0);"
        ],
        "animate": [
          "main"
        ]
      },
      "render_controllers": [
        "controller.render.seedcity",
        "controller.render.seedcity_glow"
      ],
      "spawn_egg": {
        "base_color": "#596E61",
        "overlay_color": "#FFB33C"
      },
      "enable_attachables": true
    }
  }
}
